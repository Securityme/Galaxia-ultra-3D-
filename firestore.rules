rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'imperialTitle', 'lastActiveWorldName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'imperialTitle', 'lastActiveWorldName', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.imperialTitle is string && data.imperialTitle.size() >= 1 && data.imperialTitle.size() <= 80
        && data.lastActiveWorldName is string && data.lastActiveWorldName.size() >= 1 && data.lastActiveWorldName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudWorldSave(data, saveId) {
      return data.keys().hasAll(['saveId', 'ownerId', 'name', 'worldName', 'turnNumber', 'activePresetId', 'activeZoneId', 'payload', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['saveId', 'ownerId', 'name', 'worldName', 'turnNumber', 'activePresetId', 'activeZoneId', 'payload', 'createdAt', 'updatedAt'])
        && data.saveId == saveId
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.worldName is string && data.worldName.size() >= 1 && data.worldName.size() <= 80
        && data.turnNumber is int && data.turnNumber >= 1 && data.turnNumber <= 100000
        && data.activePresetId is string && data.activePresetId.size() >= 1 && data.activePresetId.size() <= 64
        && data.activeZoneId is string && data.activeZoneId.size() >= 1 && data.activeZoneId.size() <= 64
        && data.payload is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'imperialTitle', 'lastActiveWorldName', 'updatedAt']);

      allow delete: if false;
    }

    match /worldSaves/{saveId} {
      allow get: if isSignedIn() && isValidId(saveId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(saveId)
        && isValidCloudWorldSave(incoming(), saveId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(saveId)
        && existing().ownerId == request.auth.uid
        && isValidCloudWorldSave(incoming(), saveId)
        && incoming().saveId == existing().saveId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'worldName', 'turnNumber', 'activePresetId', 'activeZoneId', 'payload', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(saveId) && existing().ownerId == request.auth.uid;
    }
  }
}
